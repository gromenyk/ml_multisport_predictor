# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
credentials*.json
token*.json

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Personal training data
data/raw_data/*
!data/raw_data/.gitkeep
data/processed_data/*
!data/processed_data/.gitkeep
data/temp/
data/derived/
garmin/fit_files/
garmin/exploration/
garmin/readable/
garmin/activities/
*.fit

# Personal athlete state and runtime planning decisions
data/athlete_state/
data/planned_history/

# Personal nutrition catalog, portions and generated meal plans
data/nutrition/

# Personal route geometry, segments and attempts
data/segments/*
!data/segments/.gitkeep

# Reusable catalogs belong in Git; personal objectives and measurements do not
data/objectives/*
!data/objectives/development_goal_catalog.json
!data/objectives/metric_catalog.json

# Generated model artifacts
ML/models/
*.joblib

# Generated evaluations and predictions
ML/results/
ML/train/*_predictions.txt
ML/train/zone_predictions.txt

# Generated experiment inputs and outputs
experiments/**/input/*
!experiments/**/input/.gitkeep
experiments/**/output/*
!experiments/**/output/.gitkeep

# Temporary, editor and OS files
*.tmp
*.log
*.bak
.streamlit/.cache/
.vscode/
.idea/
.DS_Store
Thumbs.db
build/
dist/
*.egg-info/
